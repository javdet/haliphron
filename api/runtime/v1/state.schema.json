{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haliphron.io/schemas/runtime/v1/state.json",
  "title": "Haliphron entrypoint checkpoint",
  "description": "Schema of the runs/{runID}/state.json object — the checkpoint that makes a retry idempotent. Written only by the pod, read only by the pod of the next attempt. Neither the controller nor the backend parses it: this is runtime-internal state, exposed outside only because there is nowhere else to keep it — a pod's filesystem dies with the pod.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runID", "attempt", "contractVersion", "updatedAt", "phases"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "runID": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "description": "The attempt that wrote this checkpoint. The next one reads it only if its own number is strictly greater; otherwise it is a full run."
    },
    "contractVersion": {"type": "string", "maxLength": 16},
    "startedAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "description": "The outcome of every phase that has been passed. Only run is resumed — the one phase whose repetition costs money, and the one whose result is already durable by that point. The rest are cheaper to replay than to trust a record of.",
      "properties": {
        "init": {"$ref": "#/$defs/phaseRecord"},
        "validate": {"$ref": "#/$defs/phaseRecord"},
        "fetch": {"$ref": "#/$defs/phaseRecord"},
        "checkpoint": {"$ref": "#/$defs/phaseRecord"},
        "auth": {"$ref": "#/$defs/phaseRecord"},
        "clone": {"$ref": "#/$defs/phaseRecord"},
        "role": {"$ref": "#/$defs/phaseRecord"},
        "mcp-prepare": {"$ref": "#/$defs/phaseRecord"},
        "mcp-verify": {"$ref": "#/$defs/phaseRecord"},
        "run": {"$ref": "#/$defs/phaseRecord"},
        "parse": {"$ref": "#/$defs/phaseRecord"},
        "output": {"$ref": "#/$defs/phaseRecord"},
        "persist": {"$ref": "#/$defs/phaseRecord"},
        "commit": {"$ref": "#/$defs/phaseRecord"},
        "push": {"$ref": "#/$defs/phaseRecord"},
        "pr": {"$ref": "#/$defs/phaseRecord"},
        "finalize": {"$ref": "#/$defs/phaseRecord"},
        "notify": {"$ref": "#/$defs/phaseRecord"}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the model run returned. Without this, resuming is pointless: to skip run and not know its usage is to lose the cost of the run.",
      "properties": {
        "sessionID": {"type": "string", "maxLength": 256},
        "exitCode": {"type": "integer"},
        "usage": {"$ref": "#/$defs/usage"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where what the run phase produced ended up. Filled in during persist — before the git phases, not after: those are precisely the phases that fail, and an attempt resuming past them must find the result already in storage.",
      "properties": {
        "result": {"$ref": "#/$defs/objectRef"},
        "output": {"$ref": "#/$defs/objectRef"},
        "log": {"$ref": "#/$defs/objectRef"}
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commitSHA": {"type": "string", "maxLength": 64},
        "pushed": {"type": "boolean"},
        "prURL": {"type": "string", "maxLength": 512},
        "prNumber": {"type": "integer"}
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "description": "The log upload cursor. nextChunk is not reset between attempts: numbering from zero would overwrite the previous attempt's chunks, and the UI would show two runs spliced together as one.",
      "properties": {
        "nextChunk": {"type": "integer", "minimum": 0},
        "bytesUploaded": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "phaseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {"type": "string", "enum": ["ok", "skipped", "failed"]},
        "startedAt": {"type": "string", "format": "date-time"},
        "durationMs": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "maxLength": 128}
      }
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "key"],
      "properties": {
        "bucket": {"type": "string", "maxLength": 63},
        "key": {"type": "string", "maxLength": 1024},
        "sizeBytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "contentType": {"type": "string", "maxLength": 128}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMs": {"type": "integer"},
        "numTurns": {"type": "integer"},
        "totalCostUSD": {"type": "string", "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,6})?$"},
        "inputTokens": {"type": "integer"},
        "outputTokens": {"type": "integer"},
        "cacheReadTokens": {"type": "integer"},
        "cacheWriteTokens": {"type": "integer"},
        "sessionID": {"type": "string", "maxLength": 256}
      }
    }
  }
}
