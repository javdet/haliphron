# The frontend's whole server-side job: serve a static bundle, and put the API
# on the same origin as the page that calls it.
#
# Same origin is not a convenience here. The backend sends no CORS headers —
# deliberately, since its callers are scripts and controllers rather than
# browsers — so a UI on a second origin could not call it at all. Proxying /api
# from the same nginx that serves index.html means no preflight, no CORS
# configuration to get wrong, and a bearer token that is never sent to a third
# party.
#
# ${...} are substituted at container start by the nginx entrypoint.
#
# The security headers are repeated in every location that sets an add_header
# of its own. That is not redundancy: add_header does not merge with an
# inherited set, it replaces it, so a location that adds a Cache-Control and
# nothing else silently serves the page with no CSP at all.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # A proxied result can be a whole agent transcript.
    client_max_body_size 8m;

    # Inherited by /api/, which sets no headers of its own.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    # connect-src is configurable because object-store mode hands the browser
    # presigned links to fetch, and those are on the bucket's origin, not this
    # one. Relay mode needs nothing beyond 'self'.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # The API. proxy_redirect is left off on purpose: in object-store mode the
    # backend answers a result with a 302 to a presigned URL on the bucket's
    # own host, and rewriting that Location would point the browser back here.
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_redirect off;
        proxy_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Hashed filenames, so they can be cached until the heat death of the tab.
    location /assets/ {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Everything else is the SPA. The document itself is never cached: it is
    # what names the current bundle, and a stale one pins a browser to a
    # deployment that no longer exists.
    location / {
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header Cache-Control "no-store, must-revalidate" always;
    }
}
